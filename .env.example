# Absolute public origin used for canonical URLs, OpenGraph and the sitemap.
PUBLIC_SITE_URL=http://localhost:8080
# Optional public CORS proxy template, used instead of the same-origin /yf proxy when set.
# Example: https://corsproxy.io/?url={url}
PUBLIC_CORS_PROXY=
# Annualized risk-free rate as a decimal (0.04 = 4%) used by Sharpe and Sortino ratios.
PUBLIC_RISK_FREE_RATE=0
# Host port published by docker compose.
QUANTPULSE_PORT=8080
